---
import { SIZES, type Image } from '../images';

// One image of an art entry: the picture itself and its number. The number sits on the
// image, where it costs the picture the least.
interface Props {
  shot: Image;
  n: number; // 1-based
  total: number;
  title: string; // the entry's title, which is what the picture is
}

const { shot, n, total, title } = Astro.props;
const counter = total > 1 ? `${n} / ${total}` : '';
---

<figure class="frame" style={`--ratio: ${shot.width} / ${shot.height}`}>
  <img
    {...shot}
    sizes={SIZES.gallery}
    fetchpriority={n === 1 ? 'high' : undefined}
    alt={[title, counter].filter(Boolean).join(' ')}
  />

  {counter && <figcaption>{counter}</figcaption>}
</figure>

<script>
  // A picture has no size of its own until it is loaded, so for a moment the frames of a set
  // stand on top of one another and so do their numbers. Each number waits for its picture.
  for (const img of document.querySelectorAll<HTMLImageElement>('.frame img')) {
    const mark = () => (img.dataset.loaded = '');
    if (img.complete) mark();
    else img.addEventListener('load', mark, { once: true });
  }

  // The numbers are for finding one's place, which is only while the page moves. They come up
  // with a scroll and go once it has been still for a moment
  let still: ReturnType<typeof setTimeout>;
  addEventListener(
    'scroll',
    () => {
      document.body.dataset.scrolling = '';
      clearTimeout(still);
      still = setTimeout(() => delete document.body.dataset.scrolling, 800);
    },
    { passive: true },
  );
</script>

<style>
  .frame {
    position: relative;
    margin: 0;
  }

  .frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  /* The switch on the page fits every picture of it at once. The frame takes the width that
     the height a picture is allowed turns into, by the ratio the entry knows, so the browser
     has it before the picture arrives: an empty frame is already the right shape, and the
     number on its corner is where it will stay. The picture fills the frame as it always does */
  :global(body:has(.fit:checked)) .frame {
    width: min(100%, calc((100dvh - var(--page-top) * 2) * var(--ratio)));
    margin-inline: auto;
  }

  /* Waits for the picture it counts; the script above marks the one that has arrived */
  img:not([data-loaded]) + figcaption {
    display: none;
  }

  /* The darkest of the palette, so the number reads over any picture. Out of sight until the
     page moves (see the script above) */
  figcaption {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.1em 0.7em;
    border-radius: var(--radius-pill);
    background: var(--code-bg);
    color: var(--text);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-body);
    opacity: 0;
  }

  /* Set back from the picture even while it shows, so it takes as little of it as it can */
  :global(body[data-scrolling]) figcaption {
    opacity: 0.5;
  }
</style>
