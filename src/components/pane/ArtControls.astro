---
// The control pane of an art entry. The shell stands it twice, in the right rail and in the
// menu panel, so it holds no script and no id: both switches are labels for the one checkbox
// the page holds, so the two can never disagree, and the page's script drives both buttons.
// Fitting starts on: a tall picture is worth more whole than large. Centred, as a set of
// controls is, wherever it stands.
---

<section class="controls">
  <label class="control" for="fit">
    <span class="switch"></span>
    縦幅を画面に合わせる
  </label>

  <button type="button" class="collapse quiet">画像を折りたたむ</button>
</section>

<style>
  /* Every control spans the column, so they all run to one width. The column is as wide as
     the widest of them, so the width a switch leaves empty after its label is never drawn */
  .controls {
    display: grid;
    width: fit-content;
    margin-inline: auto;
    padding: var(--pane-inset);
    gap: var(--item-gap);
  }

  /* Only there to undo the rest being opened, so it waits for that */
  .collapse {
    display: none;
    height: var(--control);
    padding: 0 1rem;
    /* The colours of the button it undoes, with .quiet, lifted off whatever pane holds it */
    background: var(--pane-button-bg);
    border: var(--pane-button-border);
    border-radius: var(--radius-pill);
    font: inherit;
    letter-spacing: var(--ls-body);
    cursor: pointer;
  }

  :global(body:has(.more[open])) .collapse {
    display: block;
  }

  .control {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-muted);
    line-height: var(--lh-snug);
    cursor: pointer;
  }

  /* A switch: the box is the track and its knob rides from one end to the other */
  .switch {
    flex: none;
    position: relative;
    width: 2.25rem;
    height: 1.25rem;
    background: var(--bg);
    border: var(--rule);
    border-radius: var(--radius-pill);
  }

  .switch::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0.1875rem;
    transform: translateY(-50%);
    width: 0.875rem;
    height: 0.875rem;
    background: var(--text-muted);
    border-radius: 50%;
  }

  /* The checkbox lives on the page, out of sight and out of reach of a sibling selector */
  :global(body:has(.fit:checked)) .control {
    color: var(--text);
  }

  :global(body:has(.fit:checked)) .switch {
    background: var(--accent);
    border-color: var(--accent);
  }

  :global(body:has(.fit:checked)) .switch::after {
    left: auto;
    right: 0.1875rem;
    background: var(--bg);
  }

  /* It is hidden, so its focus ring goes on the switch it drives */
  :global(body:has(.fit:focus-visible)) .switch {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
