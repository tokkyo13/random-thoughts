---
// Holds the page's only h1.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="page-header">
  <h1 class="page-title">{title}</h1>
</div>

<style>
  .page-header {
    margin-bottom: var(--header-gap);
  }

  .page-title {
    margin: 0;
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: var(--ls-title);
    line-height: var(--lh-title);
  }
</style>
