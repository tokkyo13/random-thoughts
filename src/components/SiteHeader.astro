---
import { SITE_TITLE, NAV_ITEMS } from '../consts';
import Logo from '../assets/logo.svg';
import Menu from '../assets/icons/menu.svg';
import Toc from '../assets/icons/toc.svg';
import Add from '../assets/icons/add.svg';

interface Props {
  // Whether the page handed over a table of contents. It decides if the menu carries tabs
  hasToc?: boolean;
}

const { hasToc = false } = Astro.props;

const path = Astro.url.pathname;
// A prefix match, so an article page (/journal/<id>/) marks Journal as current.
// Home is the exception: '/' is a prefix of everything
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

// Home lays the same links out as its own content, so it needs neither rail nor button
const isHome = path === '/';

// The rail shows the logo, and that is the way home. The panel has no logo, so it lists Home
const railItems = NAV_ITEMS.filter((item) => item.href !== '/');
---

{
  !isHome && (
    <header>
      {/* Wide viewports: a rail in the left margin, the twin of an article's TOC on the right */}
      <div class="rail">
        <a class="brand" href="/" aria-label={SITE_TITLE}>
          <Logo />
        </a>

        <nav aria-label="メインメニュー">
          <ul class="nav-list">
            {
              railItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      {/* Narrow viewports: the same links behind one button, kept within thumb reach */}
      <details class="menu">
        <summary aria-label="メニュー">
          <Add />
        </summary>

        <div class:list={['panel', { tabbed: hasToc }]}>
          {
            hasToc && (
              <Fragment>
                <input class="visually-hidden" type="radio" name="pane" id="pane-toc" aria-label="目次" checked />
                <input class="visually-hidden" type="radio" name="pane" id="pane-nav" aria-label="メニュー" />

                <div class="pane pane-toc">
                  <slot name="toc" />
                </div>
              </Fragment>
            )
          }

          <div class="pane pane-nav">
            <nav aria-label="メインメニュー">
              <ul class="nav-list">
                {
                  NAV_ITEMS.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        aria-current={isCurrent(item.href) ? 'page' : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </div>

          {
            hasToc && (
              <div class="tabs">
                <label class="quiet" for="pane-toc">
                  <Toc />
                </label>
                <label class="quiet" for="pane-nav">
                  <Menu />
                </label>
              </div>
            )
          }
        </div>
      </details>
    </header>
  )
}

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.menu');

  if (menu) {
    const close = () => {
      menu.open = false;
    };

    // Picking a link, or clicking outside, closes the menu
    document.addEventListener('click', (event) => {
      const target = event.target as Element;
      if (target.closest('a') || !target.closest('.menu')) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });

    // However it closed, including the button itself, the next open starts on the contents
    menu.addEventListener('toggle', () => {
      const toc = document.querySelector<HTMLInputElement>('#pane-toc');
      if (!menu.open && toc) toc.checked = true;
    });
  }
</script>

<style>
  /* Spans the viewport, so the dividing line runs its whole height; the padding puts the
     logo back where --page-top wants it */
  .rail {
    position: fixed;
    top: 0;
    bottom: 0;
    /* Sits on the frame's left edge, as the article's TOC sits on its right */
    left: calc(50% - var(--frame-width) / 2);
    width: var(--rail-width);
    padding-top: var(--page-top);
    border-right: var(--rule);
  }

  .brand {
    display: flex;
    text-decoration: none;
  }

  .brand :global(svg) {
    display: block;
    height: var(--logo-height);
    width: auto;
  }

  .rail ul {
    display: flex;
    flex-direction: column;
    gap: var(--nav-gap);
    margin-top: var(--nav-offset);
  }

  /* The colors come from .nav-list in global.css; the line is this rail's own */
  .rail nav a {
    display: block;
    padding-left: var(--nav-indent);
    letter-spacing: var(--ls-wide);
    border-left: var(--underline) solid transparent;
  }

  .rail nav a[aria-current='page'] {
    border-left-color: var(--accent);
  }

  .menu {
    display: none;
  }

  /* No room for the rails (see --frame-width in global.css): one button takes over */
  @media (max-width: 83rem) {
    .rail {
      display: none;
    }

    .menu {
      display: block;
      position: fixed;
      right: var(--gutter);
      bottom: max(var(--gutter), env(safe-area-inset-bottom));
      z-index: 10;
    }

    .menu summary {
      display: grid;
      place-items: center;
      width: var(--control-touch);
      height: var(--control-touch);
      background: var(--surface);
      border: var(--rule);
      border-radius: var(--radius-pill);
      cursor: pointer;
      list-style: none;
    }

    .menu summary::-webkit-details-marker {
      display: none;
    }

    .menu summary :global(svg) {
      width: var(--icon);
      height: var(--icon);
      fill: currentColor;
    }

    /* A plus turned an eighth of a turn is a cross */
    .menu[open] summary :global(svg) {
      transform: rotate(45deg);
    }

    /* Grows upward from the button, so the tabs and the nearest items stay under the thumb */
    .panel {
      position: absolute;
      right: 0;
      bottom: calc(100% + var(--nav-gap));
      display: flex;
      flex-direction: column;
      /* One width whatever the pane holds, so switching tabs never resizes the panel */
      width: min(15rem, calc(100vw - var(--gutter) * 2)); /* 240px */
      max-height: 60dvh;
      overflow: hidden; /* so the panes clip to the rounded corners */
      overscroll-behavior: contain;
      background: var(--surface);
      border: var(--rule);
      border-radius: var(--radius);
    }

    /* Without a TOC there are no tabs, and the menu pane is the whole panel */
    .pane {
      display: flex;
      flex-direction: column;
      min-height: 0;
      overflow-y: auto;
      /* A wheel over the menu stays in the menu, and never runs on into the page */
      overscroll-behavior: contain;
      padding: 0.5rem 0;

      /* Ten rows at most. A row is a link line box plus its padding, and the last term is
         this pane's own padding; the max-height above keeps the short-screen guard */
      max-height: calc((var(--fs-base) * var(--lh-body) + 1rem) * 10 + 1rem);
    }

    .tabbed .pane {
      display: none;
    }

    #pane-toc:checked ~ .pane-toc,
    #pane-nav:checked ~ .pane-nav {
      display: flex;
    }

    /* The TOC arrives through the slot, outside this component scope. Both lists carry
       .nav-list, so global.css holds their reset and their colors */
    .panel :global(a) {
      display: block;
      padding: 0.5rem 1rem;
    }

    /* The dark strip is the well the tabs sit in; only the open one lifts out of it */
    .tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: var(--bg);
    }

    /* A closed tab shows the well through it */
    .tabs label {
      display: grid;
      place-items: center;
      height: var(--control);
      cursor: pointer;
      border-radius: 0 0 var(--radius) var(--radius);
    }

    .tabs label :global(svg) {
      width: var(--icon);
      height: var(--icon);
      fill: currentColor;
    }

    .menu summary,
    .panel {
      box-shadow: var(--shadow);
    }

    /* The open tab carries the pane's own surface down, unbroken, and hangs from it */
    #pane-toc:checked ~ .tabs label[for='pane-toc'],
    #pane-nav:checked ~ .tabs label[for='pane-nav'] {
      color: var(--text);
      background: var(--surface);
    }

    /* The radios are hidden, so the focus ring goes on the tab each one drives */
    #pane-toc:focus-visible ~ .tabs label[for='pane-toc'],
    #pane-nav:focus-visible ~ .tabs label[for='pane-nav'] {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }
  }
</style>
