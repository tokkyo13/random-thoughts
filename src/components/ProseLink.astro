---
import type { HTMLAttributes } from 'astro/types';
import ExternalLink from './ExternalLink.astro';

// Links in an article body open in a new tab; links within the page stay where they are.
type Props = HTMLAttributes<'a'>;

const { href } = Astro.props;
const Link = typeof href === 'string' && href.startsWith('#') ? 'a' : ExternalLink;
---

<Link {...Astro.props}><slot /></Link>
