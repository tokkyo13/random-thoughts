---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE_LANG, SITE_TITLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  // Absolute URL of the picture a link preview should carry. Without one it carries none
  image?: string;
  // Whether the page fills its slot of the menu panel. A slot holding a false expression
  // still counts as handed over, so the page says so itself
  hasToc?: boolean;
  hasControls?: boolean;
}

const { title, description, image, hasToc = false, hasControls = false } = Astro.props;
// Home lays itself out and carries no rails, the same call SiteHeader makes
const isHome = Astro.url.pathname === '/';
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {/* The title without the site name, which a card has no room for. og:description falls
        back to the meta above, and the remaining card tags to defaults that suit this site */}
    <meta property="og:title" content={title ?? SITE_TITLE} />
    {image && <meta property="og:image" content={image} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href="/rss.xml"
    />
  </head>
  <body class:list={{ home: isHome, railed: hasToc || hasControls }}>
    <SiteHeader hasToc={hasToc} hasControls={hasControls}>
      <slot name="toc" slot="toc" />
      <slot name="controls" slot="controls" />
    </SiteHeader>

    <main class="site-main">
      <slot />
    </main>
  </body>
</html>
