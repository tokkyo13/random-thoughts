---
import type { SvgComponent } from 'astro/types';
import '../styles/global.css';
import Nav from '../components/shell/Nav.astro';
import Menu from '../components/shell/Menu.astro';
import { SITE_LANG } from '../consts';
import site from '../../content/site/site.json';

// The shell every page stands in: the navigation, main, and a control pane for how main is
// shown. Top is the navigation alone. A wide screen gives the navigation and the pane a rail
// each; a narrow one folds both into the menu, where the pane comes first
interface Props {
  title?: string;
  description?: string;
  // Absolute URL of the picture a link preview should carry. Without one it carries none
  image?: string;
  // How main is shown: prose keeps to the width text is read at, plate gives a picture the
  // whole middle and a narrower margin (see .site-main in global.css)
  main?: 'prose' | 'plate';
  // The control pane, named and drawn for its tab in the menu. Its content comes in the pane
  // slot, which a page may fill whether or not it has one: a slot holding a false expression
  // still counts as handed over, so this says whether there is a pane
  pane?: { label: string; icon: SvgComponent };
}

const { title, description, image, main = 'prose', pane } = Astro.props;
const isTop = Astro.url.pathname === '/';
const pageTitle = title ? `${title} | ${site.title}` : site.title;

// Rendered once and stood in both places, the rail and the menu. Only one of the two is ever
// on screen, and anything the pane holds is there twice: it can carry no id and no script
const shown = pane && { ...pane, html: await Astro.slots.render('pane') };
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {/* The title without the site name, which a card has no room for. og:description falls
        back to the meta above, and the remaining card tags to defaults that suit this site */}
    <meta property="og:title" content={title ?? site.title} />
    {image && <meta property="og:image" content={image} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href="/rss.xml"
    />
  </head>
  <body class:list={{ top: isTop, railed: shown }}>
    {
      isTop ? (
        <div class="site-top">
          <Nav form="top" />
        </div>
      ) : (
        <Fragment>
          <header>
            <Nav form="rail" />
            <Menu pane={shown} />
          </header>

          {shown && (
            <aside class="pane-rail wide-only">
              <Fragment set:html={shown.html} />
            </aside>
          )}

          <main class="site-main" data-main={main}>
            <slot />
          </main>
        </Fragment>
      )
    }
  </body>
</html>
