---
import { journalUrl, listPosts } from '../../posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PageHeader from '../../components/PageHeader.astro';
import Pager from '../../components/Pager.astro';
import { optionalImage, SIZES } from '../../images';
import { PER_PAGE } from '../../consts';

// /journal/  /journal/2/  /journal/2026/  /journal/2026/2/
// These never collide with article URLs: a year is four digits, an id ten.
export async function getStaticPaths() {
  const posts = await listPosts();
  const years = [...new Set(posts.map((post) => post.data.pubDate.getFullYear()))];

  const pagesOf = (list: typeof posts, year?: number) => {
    const base = year ? `/journal/${year}/` : '/journal/';
    const count = Math.max(1, Math.ceil(list.length / PER_PAGE));
    const urls = Array.from({ length: count }, (_, i) => (i === 0 ? base : `${base}${i + 1}/`));

    return urls.map((_, i) => ({
      params: { page: [year, i === 0 ? undefined : i + 1].filter(Boolean).join('/') || undefined },
      props: {
        posts: list.slice(i * PER_PAGE, (i + 1) * PER_PAGE),
        total: list.length,
        page: i + 1,
        urls,
        year,
        years,
      },
    }));
  };

  return [
    ...pagesOf(posts),
    ...years.flatMap((year) =>
      pagesOf(
        posts.filter((post) => post.data.pubDate.getFullYear() === year),
        year,
      ),
    ),
  ];
}

const { posts, total, page, urls, year, years } = Astro.props;
---

<BaseLayout title="Journal" description="これまでに書いた記事の一覧">
  <PageHeader title="Journal" lead={`${total} 件の記事`}>
    {
      years.length > 0 && (
        <details class="years">
          <summary>{year ? `${year}年` : '全体'}</summary>
          <nav aria-label="発行年でしぼりこむ">
            <a href="/journal/" aria-current={year ? undefined : 'true'}>
              全体
            </a>
            {years.map((y) => (
              <a href={`/journal/${y}/`} aria-current={y === year ? 'true' : undefined}>
                {y}年
              </a>
            ))}
          </nav>
        </details>
      )
    }
  </PageHeader>

  {
    posts.length === 0 ? (
      <p class="entry-empty">まだ記事がありません</p>
    ) : (
      <ul class="entry-list">
        {posts.map((post) => {
          const cover = optionalImage(post.data.cover && `journal/${post.id}/${post.data.cover}`);
          return (
            <li>
              <a class="entry-link" href={journalUrl(post.id)}>
                <div class="body">
                  <p class="meta">
                    <FormattedDate date={post.data.pubDate} />
                    {post.data.draft && <span class="draft">下書き</span>}
                  </p>

                  <h2 class="title">{post.data.title}</h2>
                </div>

                {cover && (
                  <div class="thumb">
                    <img {...cover} sizes={SIZES.journalThumb} alt="" />
                  </div>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    )
  }

  <Pager page={page} urls={urls} />
</BaseLayout>

<script>
  // A click anywhere outside closes the open pulldown.
  const years = document.querySelector<HTMLDetailsElement>('.years');
  document.addEventListener('click', (event) => {
    if (years && !(event.target as Element).closest('.years')) years.open = false;
  });
</script>

<style>
  .years {
    position: relative;
    letter-spacing: 0.04em;
  }

  .years summary {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.25em 0.7em;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-muted);
    cursor: pointer;
    list-style: none;
  }

  .years summary::-webkit-details-marker {
    display: none;
  }

  .years summary:hover {
    color: var(--text);
  }

  /* The chevron: two sides of a square, rotated */
  .years summary::after {
    content: '';
    width: 0.45em;
    height: 0.45em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.15em) rotate(45deg);
  }

  .years[open] summary::after {
    transform: translateY(0.1em) rotate(225deg);
  }

  .years nav {
    position: absolute;
    z-index: 1;
    top: calc(100% + 0.3rem);
    left: 0;
    min-width: 100%;
    max-height: 60dvh;
    overflow-y: auto;
    padding: 0.4rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .years nav a {
    display: block;
    padding: 0.3rem 0.9rem;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .years nav a:hover {
    color: var(--text);
  }

  .years nav a[aria-current] {
    color: var(--text);
    font-weight: 600;
  }

  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .entry-list > li {
    border-bottom: 1px solid var(--border);
  }

  .entry-link {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.75rem 0;
    text-decoration: none;
  }

  .entry-link:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: var(--underline);
    text-underline-offset: 0.25em;
  }

  .thumb {
    flex: 0 0 16rem;
  }

  .body {
    flex: 1;
    min-width: 0;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    line-height: 1.6;
  }

  .draft {
    padding: 0.05em 0.5em;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: var(--fs-xs);
  }

  .title {
    margin: 0.35rem 0 0;
    font-size: var(--fs-md);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.7;
  }

  @media (max-width: 32rem) {
    .entry-link {
      flex-direction: column;
      gap: 0.9rem;
    }

    .thumb {
      flex: none;
      width: 100%;
    }
  }
</style>
