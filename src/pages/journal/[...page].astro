---
import { journalUrl, listJournal } from '../../journal';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PageHeader from '../../components/PageHeader.astro';
import Pager from '../../components/Pager.astro';
import { optionalImage, SIZES } from '../../image';
import { PER_PAGE } from '../../consts';

// /journal/  /journal/2/
export async function getStaticPaths() {
  const posts = await listJournal();
  const count = Math.max(1, Math.ceil(posts.length / PER_PAGE));
  const urls = Array.from({ length: count }, (_, i) => (i === 0 ? '/journal/' : `/journal/${i + 1}/`));

  return urls.map((_, i) => ({
    params: { page: i === 0 ? undefined : String(i + 1) },
    props: { posts: posts.slice(i * PER_PAGE, (i + 1) * PER_PAGE), page: i + 1, urls },
  }));
}

const { posts, page, urls } = Astro.props;
---

<BaseLayout title="Journal" description="これまでに書いた記事の一覧">
  <PageHeader title="Journal" />

  {
    posts.length === 0 ? (
      <p class="entry-empty">まだ記事がありません</p>
    ) : (
      <ul class="entry-list">
        {posts.map((post) => {
          const cover = optionalImage(post.data.cover && `journal/${post.id}/${post.data.cover}`);
          return (
            <li>
              <a class="entry-link" href={journalUrl(post.id)}>
                <div class="body">
                  <p class="meta">
                    <FormattedDate date={post.data.pubDate} />
                    {post.data.draft && <span class="draft">下書き</span>}
                  </p>

                  <h2 class="entry-title">{post.data.title}</h2>
                </div>

                {cover && (
                  <div class="thumb">
                    <img {...cover} sizes={SIZES.journalThumb} alt="" />
                  </div>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    )
  }

  <Pager page={page} urls={urls} />
</BaseLayout>

<style>
  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Rules between entries only, as in .card-grid */
  .entry-list > li + li {
    border-top: var(--rule);
  }

  .entry-list > li:first-child > .entry-link {
    padding-top: 0;
  }

  .entry-link {
    display: flex;
    gap: var(--item-gap);
    align-items: flex-start;
    padding: var(--rule-gap) 0;
    text-decoration: none;
  }

  .thumb {
    flex: 0 0 16rem;
  }

  .body {
    flex: 1;
    min-width: 0;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--nav-gap);
    margin: 0;
    color: var(--text-muted);
    letter-spacing: var(--ls-body);
    line-height: var(--lh-heading);
  }

  .draft {
    padding: 0.05em 0.5em;
    border: var(--rule);
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
  }

  @media (max-width: 32rem) {
    .entry-link {
      flex-direction: column;
    }

    .thumb {
      flex: none;
      width: 100%;
    }
  }
</style>
