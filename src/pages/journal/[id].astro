---
import { render } from 'astro:content';
import { listPosts } from '../../posts';
import { optionalImage, shareImage, SIZES } from '../../images';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Fig from '../../components/Fig.astro';
import Note from '../../components/Note.astro';
import ProseLink from '../../components/ProseLink.astro';
import Code from '../../components/Code.astro';
import Pre from '../../components/Pre.astro';

export async function getStaticPaths() {
  return (await listPosts()).map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 1);
const coverKey = post.data.cover && `journal/${post.id}/${post.data.cover}`;
const cover = optionalImage(coverKey, 'eager');
---

<BaseLayout title={post.data.title} description={post.data.description} image={shareImage(coverKey)}>
  {
    /* The same list the side TOC holds. It fills the menu where the margin is too narrow */
    toc.length > 0 && (
      <nav slot="toc" aria-label="目次">
        <ul class="nav-list">
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div class="layout">
    <article>
      <header class="post-header">
        <p class="meta">
          <FormattedDate date={post.data.pubDate} />
        </p>

        <h1 class="title">{post.data.title}</h1>
      </header>

      <div class="prose">
        {
          cover && (
            <figure>
              <img {...cover} sizes={SIZES.prose} fetchpriority="high" alt="" />
            </figure>
          )
        }
        <Content components={{ Fig, Note, Code, pre: Pre, a: ProseLink }} />
      </div>
    </article>

    {
      toc.length > 0 && (
        <aside class="toc">
          <nav aria-label="目次">
            <ul class="nav-list">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>

  <nav class="post-nav">
    <a class="quiet" href="/journal/">&larr; 記事一覧へ</a>
  </nav>
</BaseLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--rail-width);
    gap: var(--rail-gap);
    align-items: start;
    /* The TOC hangs into the right margin; the prose keeps its width */
    margin-right: calc((var(--rail-width) + var(--rail-gap)) * -1);
  }

  /* The line dividing the TOC from the article. It hangs off the layout, not off the TOC,
     because it runs the height of the viewport and the TOC is only as tall as its list.
     The nav rail carries the matching line on the other side */
  .layout:has(.toc)::after {
    content: '';
    position: fixed;
    top: 0;
    bottom: 0;
    left: calc(50% + var(--frame-width) / 2 - var(--rail-width));
    border-left: var(--rule);
  }

  .toc {
    position: sticky;
    top: var(--page-top); /* level with the nav rail on the other side */
    max-height: calc(100dvh - var(--page-top) * 2);
    overflow-y: auto;
    line-height: var(--lh-snug);
    padding-left: 1rem;
  }

  .toc li + li {
    margin-top: var(--list-gap);
  }

  /* Nothing covers the top of the page any more, so a heading only needs breathing room */
  .prose :global(:is(h1, h2, h3)) {
    scroll-margin-top: 1rem;
  }

  /* The side TOC needs the full frame (see --frame-width in global.css).
     Narrower, it would scroll the page sideways, so the menu carries it instead */
  @media (max-width: 83rem) {
    .layout {
      /* Not 1fr, which cannot shrink below a wide code block */
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      margin-right: 0;
    }

    .toc,
    .layout::after {
      display: none;
    }
  }

  .post-header {
    margin-bottom: var(--header-gap);
  }

  .meta {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-body);
  }

  .title {
    margin: var(--title-gap) 0 0;
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    line-height: var(--lh-heading);
  }

  .post-nav {
    margin-top: var(--section-gap);
    padding-top: var(--rule-gap);
    border-top: var(--rule);
  }
</style>
