---
import { render } from 'astro:content';
import { listPosts } from '../../posts';
import { optionalImage, shareImage, SIZES } from '../../images';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Fig from '../../components/Fig.astro';
import Note from '../../components/Note.astro';
import ProseLink from '../../components/ProseLink.astro';
import Code from '../../components/Code.astro';
import Pre from '../../components/Pre.astro';

export async function getStaticPaths() {
  return (await listPosts()).map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 1);
const coverKey = post.data.cover && `journal/${post.id}/${post.data.cover}`;
const cover = optionalImage(coverKey, 'eager');
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={shareImage(coverKey)}
  hasToc={toc.length > 0}
>
  {
    /* The same list the side TOC holds. It fills the menu where the margin is too narrow */
    toc.length > 0 && (
      <nav slot="toc" aria-label="目次">
        <ul class="nav-list">
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <article>
      <header class="item-head">
        <p>
          <FormattedDate date={post.data.pubDate} />
        </p>

        <h1>{post.data.title}</h1>
      </header>

      <div class="prose">
        {
          cover && (
            <figure>
              <img {...cover} sizes={SIZES.prose} fetchpriority="high" alt="" />
            </figure>
          )
        }
        <Content components={{ Fig, Note, Code, pre: Pre, a: ProseLink }} />
      </div>
    </article>

    {
      toc.length > 0 && (
        <aside class="toc">
          <nav aria-label="目次">
            <ul class="nav-list">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
</BaseLayout>

<style>
  /* The right margin, against the edge of the screen and just inside the line the header
     draws there. The nav rail is its twin on the left, and the article keeps the middle */
  .toc {
    position: fixed;
    top: var(--page-top); /* level with the nav rail on the other side */
    right: 0;
    width: var(--rail-width);
    padding: 0 var(--gutter) 0 1rem;
    max-height: calc(100dvh - var(--page-top) * 2);
    overflow-y: auto;
    line-height: var(--lh-snug);
  }

  .toc li + li {
    margin-top: var(--list-gap);
  }

  /* Nothing covers the top of the page any more, so a heading only needs breathing room */
  .prose :global(:is(h1, h2, h3)) {
    scroll-margin-top: 1rem;
  }

  /* No room for the margins (see --frame-width in global.css): the menu carries the list */
  @media (max-width: 85rem) {
    .toc {
      display: none;
    }
  }

  .item-head {
    margin-bottom: var(--header-gap);
  }
</style>
