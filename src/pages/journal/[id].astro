---
import { render } from 'astro:content';
import { listPosts } from '../../posts';
import { optionalImage, shareImage, SIZES } from '../../images';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Fig from '../../components/mdx/Fig.astro';
import Note from '../../components/mdx/Note.astro';
import ProseLink from '../../components/mdx/ProseLink.astro';
import Code from '../../components/mdx/Code.astro';
import Pre from '../../components/mdx/Pre.astro';
import Toc from '../../components/pane/Toc.astro';
import TocIcon from '../../assets/icons/toc.svg';

export async function getStaticPaths() {
  return (await listPosts()).map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 1);
const coverKey = post.data.cover && `journal/${post.id}/${post.data.cover}`;
const cover = optionalImage(coverKey, 'eager');
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={shareImage(coverKey)}
  pane={toc.length > 0 ? { label: '目次', icon: TocIcon } : undefined}
>
  <Toc slot="pane" headings={toc} />

  <article>
    <header class="item-head">
      <p>
        <FormattedDate date={post.data.pubDate} />
      </p>

      <h1>{post.data.title}</h1>
    </header>

    <div class="prose">
      {
        cover && (
          <figure>
            <img {...cover} sizes={SIZES.prose} fetchpriority="high" alt="" />
          </figure>
        )
      }
      <Content components={{ Fig, Note, Code, pre: Pre, a: ProseLink }} />
    </div>
  </article>
</BaseLayout>

<style>
  /* Nothing covers the top of the page any more, so a heading only needs breathing room */
  .prose :global(:is(h1, h2, h3)) {
    scroll-margin-top: 1rem;
  }

  .item-head {
    margin-bottom: var(--header-gap);
  }
</style>
