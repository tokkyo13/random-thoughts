---
import { listPictures, pictureUrl } from '../../pictures';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Pager from '../../components/Pager.astro';
import { optionalImage, SIZES } from '../../images';
import { PER_PAGE } from '../../consts';

// /picture/  /picture/2/
export async function getStaticPaths() {
  const pictures = await listPictures();
  const count = Math.max(1, Math.ceil(pictures.length / PER_PAGE));
  const urls = Array.from({ length: count }, (_, i) => (i === 0 ? '/picture/' : `/picture/${i + 1}/`));

  return urls.map((_, i) => ({
    params: { page: i === 0 ? undefined : String(i + 1) },
    props: { pictures: pictures.slice(i * PER_PAGE, (i + 1) * PER_PAGE), total: pictures.length, page: i + 1, urls },
  }));
}

const { pictures, total, page, urls } = Astro.props;
---

<BaseLayout title="Picture" description="描いたイラストの一覧">
  <PageHeader title="Picture" lead={`${total} 枚のイラスト`} />

  {
    pictures.length === 0 ? (
      <p class="entry-empty">まだイラストがありません</p>
    ) : (
      <ul class="card-grid">
        {pictures.map(({ id, data }) => {
          const cover = optionalImage(data.cover && `picture/${id}/${data.cover}`);
          return (
            <li>
              <a class="card" href={pictureUrl(id)}>
                <div class="thumb">{cover && <img {...cover} sizes={SIZES.gridThumb} alt="" />}</div>
                <h2 class="entry-title">{data.title}</h2>
              </a>
            </li>
          );
        })}
      </ul>
    )
  }

  <Pager page={page} urls={urls} />
</BaseLayout>

<style>
  /* Square, not the 16/9 of the other lists: an illustration is as often tall as it is wide,
     and object-fit in global.css crops it from the center either way */
  .thumb {
    aspect-ratio: 1;
  }
</style>
