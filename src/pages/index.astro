---
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../assets/logo.svg";
import { NAV_ITEMS, SITE_DESCRIPTION, SITE_TITLE } from "../consts";

// This page is Top, so the list holds only the places to go from here
const destinations = NAV_ITEMS.filter((item) => item.href !== "/");
---

<BaseLayout description={SITE_DESCRIPTION}>
  <div class="brand" role="img" aria-label={SITE_TITLE}>
    <Logo />
  </div>

  <nav aria-label="メインメニュー">
    <ul class="nav-list">
      {
        destinations.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>

<style>
  /* On this page only. It is the whole content, so it centers across the page */
  :global(.site-main) {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Too narrow for the side rails (see the rails in global.css), so nothing lines up
     with the top any more and the page sits in the middle instead */
  @media (max-width: 85rem) {
    :global(.site-main) {
      justify-content: center;
    }
  }

  .brand :global(svg) {
    display: block;
    height: var(--logo-height);
    width: auto;
  }

  /* Spacing follows the rail; the rail's left indent does not, there being no left edge here */
  ul {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--nav-gap);
    margin-top: var(--nav-offset);
  }

  a {
    display: block;
    letter-spacing: var(--ls-wide);
  }
</style>
