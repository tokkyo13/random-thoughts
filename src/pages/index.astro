---
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../assets/logo.svg";
import { NAV_ITEMS, SITE_DESCRIPTION, SITE_TITLE } from "../consts";

// This page is Home, so the list holds only the places to go from here
const destinations = NAV_ITEMS.filter((item) => item.href !== "/");
---

<BaseLayout description={SITE_DESCRIPTION}>
  <div class="brand" role="img" aria-label={SITE_TITLE}>
    <Logo />
  </div>

  <nav aria-label="メインメニュー">
    <ul>
      {
        destinations.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>

<style>
  /* On this page only. It is the whole content, so it sits in the middle of the viewport */
  :global(.site-main) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .brand :global(svg) {
    display: block;
    height: var(--logo-height);
    width: auto;
  }

  /* Spacing follows the rail; the rail's left indent does not, there being no left edge here */
  ul {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--text);
  }
</style>
