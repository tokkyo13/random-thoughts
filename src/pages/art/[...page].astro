---
import { listArt, artUrl } from '../../art';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Pager from '../../components/Pager.astro';
import { optionalImage, SIZES } from '../../image';
import { PER_PAGE } from '../../consts';

// /art/  /art/2/
export async function getStaticPaths() {
  const pieces = await listArt();
  const count = Math.max(1, Math.ceil(pieces.length / PER_PAGE));
  const urls = Array.from({ length: count }, (_, i) => (i === 0 ? '/art/' : `/art/${i + 1}/`));

  return urls.map((_, i) => ({
    params: { page: i === 0 ? undefined : String(i + 1) },
    props: { pieces: pieces.slice(i * PER_PAGE, (i + 1) * PER_PAGE), page: i + 1, urls },
  }));
}

const { pieces, page, urls } = Astro.props;
---

<BaseLayout title="Art" description="描いたイラストの一覧">
  <PageHeader title="Art" />

  {
    pieces.length === 0 ? (
      <p class="entry-empty">まだイラストがありません</p>
    ) : (
      <ul class="card-grid">
        {pieces.map(({ id, data }) => {
          const cover = optionalImage(data.cover && `art/${id}/${data.cover}`);
          return (
            <li>
              <a class="card" href={artUrl(id)}>
                <div class="thumb">{cover && <img {...cover} sizes={SIZES.gridThumb} alt="" />}</div>
                <h2 class="entry-title">{data.title}</h2>
              </a>
            </li>
          );
        })}
      </ul>
    )
  }

  <Pager page={page} urls={urls} />
</BaseLayout>

<style>
  /* Square, not the 16/9 of the other lists: an illustration is as often tall as it is wide,
     and object-fit in global.css crops it from the center either way */
  .thumb {
    aspect-ratio: 1;
  }
</style>
