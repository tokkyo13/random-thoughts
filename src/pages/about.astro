---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const about = (await getEntry('about', 'about'))!;
const { Content } = await render(about);
const { name, latin, avatar } = about.data;
---

<BaseLayout title="About" description="このサイトについて">
  <PageHeader title="About" />

  <div class="profile">
    {/* Served as it is: the file is already an AVIF at twice the size shown (see README.md) */}
    <img class="avatar" src={avatar.src} alt="" width={avatar.width} height={avatar.height} />

    <div class="prose body">
      <h2 class="name">{name} / {latin}</h2>
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .profile {
    display: flex;
    gap: var(--col-gap);
  }

  .avatar {
    flex: 0 0 10rem;
    width: 10rem;
    height: 10rem;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }

  .body {
    flex: 1;
    min-width: 0;
  }

  .name {
    font-size: var(--fs-lg);
  }

  @media (max-width: 32rem) {
    .profile {
      flex-direction: column;
      align-items: center;
      gap: var(--item-gap);
    }

    /* Full width, instead of shrinking to its content as align-items: center would */
    .body {
      align-self: stretch;
    }
  }
</style>
