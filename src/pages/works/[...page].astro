---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Pager from '../../components/Pager.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { optionalImage, SIZES } from '../../images';
import { PER_PAGE } from '../../consts';

// /works/  /works/2/
export async function getStaticPaths() {
  const works = await getCollection('works');
  const count = Math.max(1, Math.ceil(works.length / PER_PAGE));
  const urls = Array.from({ length: count }, (_, i) => (i === 0 ? '/works/' : `/works/${i + 1}/`));

  return urls.map((_, i) => ({
    params: { page: i === 0 ? undefined : String(i + 1) },
    props: { works: works.slice(i * PER_PAGE, (i + 1) * PER_PAGE), page: i + 1, urls },
  }));
}

const { works, page, urls } = Astro.props;
---

<BaseLayout title="Works" description="公開している web アプリなどの一覧">
  <PageHeader title="Works" lead="作ったもの" />

  {
    works.length === 0 ? (
      <p class="entry-empty">まだ登録がありません</p>
    ) : (
      <ul class="work-grid">
        {works.map(({ id, data }) => {
          const cover = optionalImage(data.cover && `works/${id}/${data.cover}`);
          return (
            <li>
              <ExternalLink class="card" href={data.url}>
                <div class="thumb">{cover && <img {...cover} sizes={SIZES.worksThumb} alt="" />}</div>
                <h2 class="title">{data.title}</h2>
                <p class="description">{data.description}</p>
              </ExternalLink>
            </li>
          );
        })}
      </ul>
    )
  }

  <Pager page={page} urls={urls} />
</BaseLayout>

<style>
  .work-grid {
    --col-gap: 2rem;
    --rule-gap: 2rem; /* between a row rule and the content on either side of it */
    --rule: 1px solid var(--border);

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--col-gap);
    row-gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    /* Clips the rule above the first row and the overhang past the edge columns, so no
       :nth-child cases per column count are needed.
       Tradeoff: :focus-visible on the edge columns loses its outer side; if that matters,
       drop overflow and cancel the edges with :nth-child per column count */
    overflow: hidden;
  }

  /* Space below only, so each rule sits mid-gap above the next row */
  .work-grid > li {
    position: relative;
    padding-bottom: calc(var(--rule-gap) * 2);
  }

  /* Extends by half the column gap on each side, so neighboring rules join into one line */
  .work-grid > li::before {
    content: '';
    position: absolute;
    top: calc(var(--rule-gap) * -1);
    left: calc(var(--col-gap) / -2);
    right: calc(var(--col-gap) / -2);
    border-top: var(--rule);
  }

  @media (max-width: 48rem) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 32rem) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    display: block;
    text-decoration: none;
  }

  .card:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: var(--underline);
    text-underline-offset: 0.25em;
  }

  .title {
    margin: 0.9rem 0 0;
    font-size: var(--fs-md);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.7;
  }

  .description {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    line-height: 1.8;
  }
</style>
