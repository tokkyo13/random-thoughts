---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ExternalLink from "../components/ExternalLink.astro";
import { SOURCE_URL } from "../consts";

// A path stays on this site, so it does not get the external-link treatment
const links = [
  { label: "Source", url: SOURCE_URL },
  { label: "RSS", url: "/rss.xml" },
  { label: "Bluesky", url: "https://bsky.app/profile/tokkyo13.bsky.social" },
  { label: "Pixiv", url: "https://pixiv.me/tokkyo13" },
  { label: "GitHub", url: "https://github.com/tokkyo13" },
];
---

<BaseLayout title="Link" description="リンク集">
  <PageHeader title="Link" lead="リンク集" />

  <div class="prose">
    <ul>
      {
        links.map((link) => (
          <li>
            {link.url.startsWith("/") ? (
              <a href={link.url}>{link.label}</a>
            ) : (
              <ExternalLink href={link.url}>{link.label}</ExternalLink>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
