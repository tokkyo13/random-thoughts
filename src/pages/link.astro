---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ExternalLink from "../components/ExternalLink.astro";

// content/link/link.json: the label is the id, and the file's order is the order shown
const links = (await getCollection("link")).map((link) => ({ label: link.id, url: link.data.url }));
---

<BaseLayout title="Link" description="リンク集">
  <PageHeader title="Link" />

  <div class="prose">
    <ul>
      {
        links.map((link) => (
          <li>
            {/* A path stays on this site, so it does not get the external-link treatment */}
            {link.url.startsWith("/") ? (
              <a href={link.url}>{link.label}</a>
            ) : (
              <ExternalLink href={link.url}>{link.label}</ExternalLink>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
