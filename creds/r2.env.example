# Template for the R2 credentials. Copy this file to creds/r2.env and fill it in.
# Credential files are ignored by Git (*.env), so the values stay out of commits.
#
# Create an R2 API token with "Object Read & Write" permission, limited to the
# random-thoughts-images bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
