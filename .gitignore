dist/
.astro/
.wrangler/

# dependencies
node_modules/

# credential files; the *.env.example templates stay tracked. See README.md
*.env

# the images themselves, restored from R2; only the manifest beside them is tracked
content/image/*/

# personal settings; see "Claude Code" in README.md for the recommended .claude/settings.json
.claude/
.vscode/
.idea/
.DS_Store
